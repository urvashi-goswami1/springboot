package com.example.rbac.controller;
import com.example.rbac.model.AdminItem;
import com.example.rbac.repository.AdminItemRepository;
import java.util.List;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.web.bind.annotation.*;
@RestController
@RequestMapping("/api/admin/data")
public class AdminController {
 private final AdminItemRepository repository;
 public AdminController(AdminItemRepository repository) {
 this.repository = repository;
 }
 // GET /api/admin/data -> 200 OK (ADMIN) / 403 (USER)
 @GetMapping
 @PreAuthorize("hasRole('ADMIN')")
 public List<AdminItem> getAdminData() {
Practical No. 17 - Role-Based Access Control (RBAC) with Spring Security Page 6
 return repository.findAll();
 }
 // POST /api/admin/data -> 201 Created (ADMIN) / 403 (USER)
 @PostMapping
 @PreAuthorize("hasRole('ADMIN')")
 public ResponseEntity<AdminItem> create(@RequestBody AdminItem item) {
 item.setId(null); // force INSERT
 AdminItem saved = repository.save(item);
 return ResponseEntity.status(HttpStatus.CREATED).body(saved);
 }
 // PUT /api/admin/data/{id} -> 200 OK (ADMIN) / 403 (USER) / 404 if id not found
 @PutMapping("/{id}")
 @PreAuthorize("hasRole('ADMIN')")
 public ResponseEntity<AdminItem> update(@PathVariable Long id,
 @RequestBody AdminItem updated) {
 return repository.findById(id)
 .map(existing -> {
 existing.setLabel(updated.getLabel());
 return ResponseEntity.ok(repository.save(existing));
 })
 .orElse(ResponseEntity.notFound().build());
 }
 // DELETE /api/admin/data/{id} -> 204 No Content (ADMIN) / 403 (USER) / 404
 @DeleteMapping("/{id}")
 @PreAuthorize("hasRole('ADMIN')")
 public ResponseEntity<Void> delete(@PathVariable Long id) {
 if (!repository.existsById(id)) {
 return ResponseEntity.notFound().build();
 }
 repository.deleteById(id);
 return ResponseEntity.noContent().build();
 }
}
