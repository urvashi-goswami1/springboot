controller/SecureNoteController.java (Steps 5 and 6: secured CRUD)
package com.example.basicauth.controller;
import com.example.basicauth.model.Note;
import com.example.basicauth.repository.NoteRepository;
import java.util.List;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
@RestController
@RequestMapping("/api/secure/data")
public class SecureNoteController {
 private final NoteRepository repository;
 public SecureNoteController(NoteRepository repository) {
 this.repository = repository;
 }
 // GET /api/secure/data -> 200 OK
 @GetMapping
 public List<Note> getAll() {
 return repository.findAll();
 }
 // POST /api/secure/data -> 201 Created
 @PostMapping
 public ResponseEntity<Note> create(@RequestBody Note note) {
 note.setId(null); // force a new record
 Note saved = repository.save(note);
 return ResponseEntity.status(HttpStatus.CREATED).body(saved);
 }
 // PUT /api/secure/data/{id} -> 200 OK (or 404 if id not found)
 @PutMapping("/{id}")
 public ResponseEntity<Note> update(@PathVariable Long id, @RequestBody Note updated) {
 return repository.findById(id)
 .map(existing -> {
 existing.setText(updated.getText());
 return ResponseEntity.ok(repository.save(existing));
 })
 .orElse(ResponseEntity.notFound().build());
 }
 // DELETE /api/secure/data/{id} -> 204 No Content (or 404 if id not found)
 @DeleteMapping("/{id}")
 public ResponseEntity<Void> delete(@PathVariable Long id) {
 if (!repository.existsById(id)) {
 return ResponseEntity.notFound().build();
 }
 repository.deleteById(id);
 return ResponseEntity.noContent().build();
 }
}
