4.4 EmployeeService (new) — throws ResourceNotFoundException, not null
src/main/java/com/example/api/employee/service/{EmployeeService,EmployeeServiceImpl
}.java
// service/EmployeeService.java
package com.example.api.employee.service;
import com.example.api.employee.entity.Employee;
import java.util.List;
public interface EmployeeService {
 Employee create(Employee employee);
 List<Employee> getAll();
 Employee getById(int id);
 Employee update(int id, Employee employee);
 void delete(int id);
}
// ---------------------------------------------------------------
// service/EmployeeServiceImpl.java
package com.example.api.employee.service;
import com.example.api.employee.entity.Employee;
import com.example.api.employee.repository.EmployeeRepository;
import com.example.api.exception.ResourceNotFoundException;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import java.util.List;
@Service
public class EmployeeServiceImpl implements EmployeeService {
 private final EmployeeRepository employeeRepository;
 @Autowired
 public EmployeeServiceImpl(EmployeeRepository employeeRepository) {
 this.employeeRepository = employeeRepository;
 }
 @Override
 public Employee create(Employee employee) {
 return employeeRepository.save(employee);
 }
 @Override
 public List<Employee> getAll() {
 return employeeRepository.findAll();
 }
 @Override
 public Employee getById(int id) {
 // Step 3: throw instead of returning null
 return employeeRepository.findById(id)
 .orElseThrow(() -> new ResourceNotFoundException(
 "Employee not found with id: " + id));
 }
 @Override
 public Employee update(int id, Employee employee) {
 Employee existing = employeeRepository.findById(id)
 .orElseThrow(() -> new ResourceNotFoundException(
 "Employee not found with id: " + id));
 if (employee.getEmpName() != null) {
 existing.setEmpName(employee.getEmpName());
 }
 if (employee.getDepartment() != null) {
 existing.setDepartment(employee.getDepartment());
 }
 // password/salary preserved untouched (Practical 12 rule)
 return employeeRepository.save(existing);
 }
 @Override
 public void delete(int id) {
 // Step 7: PUT/DELETE also route through ResourceNotFoundException,
 // never a raw NullPointerException
 if (!employeeRepository.existsById(id)) {
 throw new ResourceNotFoundException("Employee not found with id: " + id);
 }
 employeeRepository.deleteById(id);
 }
}


4.5 EmployeeRestController.java (now delegates to the service)
src/main/java/com/example/api/employee/controller/EmployeeRestController.java
package com.example.api.employee.controller;
import com.example.api.employee.dto.EmployeeDTO;
import com.example.api.employee.entity.Employee;
import com.example.api.employee.mapper.EmployeeMapper;
import com.example.api.employee.service.EmployeeService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import java.util.List;
import java.util.stream.Collectors;
@RestController
@RequestMapping("/api/employees")
public class EmployeeRestController {
 private final EmployeeService employeeService;
 @Autowired
 public EmployeeRestController(EmployeeService employeeService) {
 this.employeeService = employeeService;
 }
 @GetMapping
 public ResponseEntity<List<EmployeeDTO>> getAll() {
 List<EmployeeDTO> dtos = employeeService.getAll().stream()
 .map(EmployeeMapper::toDto)
 .collect(Collectors.toList());
 return ResponseEntity.ok(dtos);
 }
 // Any non-existent id here now bubbles up ResourceNotFoundException
 // from the service, caught by GlobalExceptionHandler -> 404 JSON.
 @GetMapping("/{id}")
 public ResponseEntity<EmployeeDTO> getById(@PathVariable int id) {
 Employee employee = employeeService.getById(id);
 return ResponseEntity.ok(EmployeeMapper.toDto(employee));
 }
 @PostMapping
 public ResponseEntity<EmployeeDTO> create(@RequestBody EmployeeDTO dto) {
 Employee saved = employeeService.create(EmployeeMapper.toEntity(dto));
 return new ResponseEntity<>(EmployeeMapper.toDto(saved), HttpStatus.CREATED);
 }
 @PutMapping("/{id}")
 public ResponseEntity<EmployeeDTO> update(@PathVariable int id, @RequestBody EmployeeDTO dto) {
 Employee updated = employeeService.update(id, EmployeeMapper.toEntity(dto));
 return ResponseEntity.ok(EmployeeMapper.toDto(updated));
 }
 @DeleteMapping("/{id}")
 public ResponseEntity<Void> delete(@PathVariable int id) {
 employeeService.delete(id);
 return ResponseEntity.noContent().build();
 }
}

5. Customer Module — Validation Errors Now Structured
The Customer entity keeps its Practical 13 validation annotations unchanged. The controller is updated only
to raise ResourceNotFoundException on a missing id, so it too flows through the same
GlobalExceptionHandler; the @Valid-triggered MethodArgumentNotValidException is now
caught globally, replacing the bare 400 from Practical 13 with a structured field-error message.


