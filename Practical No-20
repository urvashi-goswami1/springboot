package com.example.corsdemo.controller;
import com.example.corsdemo.model.Note;
import com.example.corsdemo.repository.NoteRepository;
import java.util.List;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
@RestController
@RequestMapping("/api/secure/data")
public class SecureNoteController {
 private final NoteRepository repository;
 public SecureNoteController(NoteRepository repository) {
 this.repository = repository;
 }
 @GetMapping // 200 OK
 public List<Note> getAll() {
 return repository.findAll();
 }
 @PostMapping // 201 Created
 public ResponseEntity<Note> create(@RequestBody Note note) {
 note.setId(null);
 return ResponseEntity.status(HttpStatus.CREATED).body(repository.save(note));
 }
 @PutMapping("/{id}") // 200 OK (404 if not found)
 public ResponseEntity<Note> update(@PathVariable Long id, @RequestBody Note updated) {
 return repository.findById(id)
