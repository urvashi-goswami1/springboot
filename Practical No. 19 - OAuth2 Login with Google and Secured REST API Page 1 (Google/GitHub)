 }
}
Step 4: controller/UserInfoController.java
package com.example.oauthlogin.controller;
import java.util.LinkedHashMap;
import java.util.Map;
import org.springframework.security.core.Authentication;
import org.springframework.security.oauth2.core.user.OAuth2User;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
@RestController
@RequestMapping("/api/user")
public class UserInfoController {
 // GET /api/user/profile -> 200 OK {"name": "...", "email": "...", "authenticatedVia": "..."}
 // Works for both kinds of caller:
 // - browser session after Google login: principal is an OAuth2User
 // - Postman with a Bearer ID token: principal is a Jwt
 @GetMapping("/profile")
 public Map<String, Object> getUserProfile(Authentication authentication) {
 Object principal = authentication.getPrincipal();
 Map<String, Object> attributes;
 String via;
 if (principal instanceof OAuth2User oauth2User) {
 attributes = oauth2User.getAttributes();
 via = "OAuth2 login session";
 } else if (principal instanceof Jwt jwt) {
 attributes = jwt.getClaims();
 via = "Bearer token";
 } else {
 attributes = Map.of();
 via = "unknown";
 }
 Map<String, Object> profile = new LinkedHashMap<>();
 profile.put("name", attributes.get("name"));
 profile.put("email", attributes.get("email"));
 profile.put("authenticatedVia", via);
 return profile;
 }
}
Step 6: controller/NoteController.java (per-user CRUD)
package com.example.oauthlogin.controller;
import com.example.oauthlogin.model.Note;
import com.example.oauthlogin.repository.NoteRepository;
import java.util.List;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.core.Authentication;
import org.springframework.web.bind.annotation.*;
@RestController
@RequestMapping("/api/user/notes")
public class NoteController {
 private final NoteRepository repository;
 public NoteController(NoteRepository repository) {
 this.repository = repository;
 }
 // authentication.getName() is the Google user id ("sub") for both session and Bearer callers
 // GET /api/user/notes -> 200 OK (only the caller's own notes)
Practical No. 19 - OAuth2 Login with Google and Secured REST API Page 6
 @GetMapping
 public List<Note> list(Authentication authentication) {
 return repository.findByOwner(authentication.getName());
 }
 // POST /api/user/notes -> 201 Created
 @PostMapping
 public ResponseEntity<Note> create(Authentication authentication, @RequestBody Note note) {
 note.setId(null); // force INSERT
 note.setOwner(authentication.getName()); // owner always comes from the login
 return ResponseEntity.status(HttpStatus.CREATED).body(repository.save(note));
 }
 // PUT /api/user/notes/{id} -> 200 OK (404 if it does not exist or belongs to someone else)
 @PutMapping("/{id}")
 public ResponseEntity<Note> update(Authentication authentication, @PathVariable Long id,
 @RequestBody Note updated) {
 return repository.findByIdAndOwner(id, authentication.getName())
 .map(existing -> {
 existing.setText(updated.getText());
 return ResponseEntity.ok(repository.save(existing));
 })
 .orElse(ResponseEntity.notFound().build());
 }
 // DELETE /api/user/notes/{id} -> 204 No Content (404 if not found / not yours)
 @DeleteMapping("/{id}")
 public ResponseEntity<Void> delete(Authentication authentication, @PathVariable Long id) {
 return repository.findByIdAndOwner(id, authentication.getName())
 .map(existing -> {
 repository.delete(existing);
 return ResponseEntity.noContent().<Void>build();
 })
 .orElse(ResponseEntity.notFound().build());
 }
}
