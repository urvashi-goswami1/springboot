 @Bean
 public SecurityFilterChain filterChain(HttpSecurity http) throws Exception {
 http
 .csrf(csrf -> csrf.disable()) // stateless API, no cookies, no CSRF risk
 .sessionManagement(s -> s.sessionCreationPolicy(SessionCreationPolicy.STATELESS))
 .authorizeHttpRequests(auth -> auth
 .requestMatchers(PathRequest.toH2Console()).permitAll() // dev only
 .requestMatchers("/dev/**").permitAll() // Option B only
 .requestMatchers("/api/secure/**").authenticated()
 .anyRequest().authenticated()
 )
 // validate incoming "Authorization: Bearer <JWT>" headers
 .oauth2ResourceServer(oauth2 -> oauth2.jwt(Customizer.withDefaults()))
 .headers(h -> h.frameOptions(f -> f.sameOrigin())); // for H2 console frames
 return http.build();
 }
}
