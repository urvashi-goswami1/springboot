Step 4 (Option A): Obtaining a JWT from Keycloak
Keycloak is a free, open-source Authorization Server. Start it with Docker (port 8180 so it does not clash
with Spring Boot on 8080):
docker run -p 8180:8080 -e KEYCLOAK_ADMIN=admin -e KEYCLOAK_ADMIN_PASSWORD=admin \
 quay.io/keycloak/keycloak:25.0.6 start-dev
• Open http://localhost:8180 -> Administration Console (admin / admin).
• Create a realm named demo-realm. Its issuer is then http://localhost:8180/realms/demo-realm.
• Client scopes -> create two scopes named read and write (Type: Default, Include in token scope: ON).
• Clients -> Create client: Client ID postman-client; Client authentication: ON; tick Service accounts
roles (this enables the client credentials grant). Save.
• In the client's Client scopes tab, add read and write. In the Credentials tab, copy the Client secret.
• Optional: Realm settings -> Tokens -> set Access Token Lifespan to 1 minute, to demonstrate an
expired token.
Postman token request:
POST http://localhost:8180/realms/demo-realm/protocol/openid-connect/token
Body (x-www-form-urlencoded):
 grant_type = client_credentials
 client_id = postman-client
 client_secret = <secret copied from Credentials tab>
 scope = read write
Response: { "access_token": "eyJhbGciOi...", "expires_in": 300, "token_type": "Bearer", ... }
Copy the access_token value. Decode it at jwt.io to confirm it contains "scope": "read write" and
the correct iss.
Step 4 (Option B): No Authorization Server available? Local test-token generator
For a lab machine without Docker, run the app with the dev profile. It signs test JWTs with a temporary
RSA key created at startup and validates them with the matching public key. Development use only:
never deploy this, because anyone can mint tokens.
package com.example.jwtdemo.config;
import com.nimbusds.jose.jwk.JWK;
import com.nimbusds.jose.jwk.JWKSet;
import com.nimbusds.jose.jwk.RSAKey;
import com.nimbusds.jose.jwk.source.ImmutableJWKSet;
import java.security.KeyPair;
import java.security.KeyPairGenerator;
import java.security.interfaces.RSAPublicKey;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.context.annotation.Profile;
import org.springframework.security.oauth2.jwt.JwtDecoder;
import org.springframework.security.oauth2.jwt.JwtEncoder;
import org.springframework.security.oauth2.jwt.NimbusJwtDecoder;
import org.springframework.security.oauth2.jwt.NimbusJwtEncoder;
@Configuration
@Profile("dev")
public class DevJwtConfig {
 private final KeyPair keyPair = generateKeyPair();
 @Bean // validates tokens (replaces the issuer-uri based decoder)
Practical No. 18 - OAuth2 Resource Server with JWT Page 6
 public JwtDecoder jwtDecoder() {
 return NimbusJwtDecoder.withPublicKey((RSAPublicKey) keyPair.getPublic()).build();
 }
 @Bean // signs tokens
 public JwtEncoder jwtEncoder() {
 JWK jwk = new RSAKey.Builder((RSAPublicKey) keyPair.getPublic())
 .privateKey(keyPair.getPrivate())
 .keyID("dev-key")
 .build();
 return new NimbusJwtEncoder(new ImmutableJWKSet<>(new JWKSet(jwk)));
 }
 private static KeyPair generateKeyPair() {
 try {
 KeyPairGenerator generator = KeyPairGenerator.getInstance("RSA");
 generator.initialize(2048);
 return generator.generateKeyPair();
 } catch (Exception e) {
 throw new IllegalStateException(e);
 }
 }
}
package com.example.jwtdemo.controller;
import java.time.Instant;
import java.time.temporal.ChronoUnit;
import java.util.Map;
import org.springframework.context.annotation.Profile;
import org.springframework.security.oauth2.jwt.JwtClaimsSet;
import org.springframework.security.oauth2.jwt.JwtEncoder;
import org.springframework.security.oauth2.jwt.JwtEncoderParameters;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;
@RestController
@Profile("dev")
public class DevTokenController {
 private final JwtEncoder encoder;
 public DevTokenController(JwtEncoder encoder) {
 this.encoder = encoder;
 }
 // GET /dev/token?scope=read%20write&expired=false
 @GetMapping("/dev/token")
 public Map<String, String> token(@RequestParam(defaultValue = "read write") String scope,
 @RequestParam(defaultValue = "false") boolean expired) {
 Instant now = Instant.now();
 Instant issuedAt = expired ? now.minus(2, ChronoUnit.HOURS) : now;
 Instant expiresAt = expired ? now.minus(1, ChronoUnit.HOURS)
 : now.plus(1, ChronoUnit.HOURS);
 JwtClaimsSet claims = JwtClaimsSet.builder()
 .issuer("http://localhost:8080")
 .subject("student")
 .issuedAt(issuedAt)
 .expiresAt(expiresAt)
 .claim("scope", scope) // becomes SCOPE_read, SCOPE_write
 .build();
 String jwt = encoder.encode(JwtEncoderParameters.from(claims)).getTokenValue();
 return Map.of("access_token", jwt, "token_type", "Bearer");
 }
}
