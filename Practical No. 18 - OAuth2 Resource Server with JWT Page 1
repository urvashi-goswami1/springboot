package com.example.jwtdemo.controller;
import com.example.jwtdemo.model.Note;
import com.example.jwtdemo.repository.NoteRepository;
import java.util.List;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.web.bind.annotation.*;
@RestController
@RequestMapping("/api/secure/data")
public class SecureDataController {
 private final NoteRepository repository;
 public SecureDataController(NoteRepository repository) {
 this.repository = repository;
 }
 // GET -> 200 OK (token must contain scope "read")
 @GetMapping
 @PreAuthorize("hasAuthority('SCOPE_read')")
 public List<Note> getSecureData() {
 return repository.findAll();
 }
 // POST -> 201 Created (scope "write")
 @PostMapping
 @PreAuthorize("hasAuthority('SCOPE_write')")
 public ResponseEntity<Note> create(@RequestBody Note note) {
 note.setId(null); // force INSERT
 return ResponseEntity.status(HttpStatus.CREATED).body(repository.save(note));
 }
 // PUT -> 200 OK (404 if id not found) (scope "write")
 @PutMapping("/{id}")
 @PreAuthorize("hasAuthority('SCOPE_write')")
 public ResponseEntity<Note> update(@PathVariable Long id, @RequestBody Note updated) {
 return repository.findById(id)
 .map(existing -> {
 existing.setText(updated.getText());
 return ResponseEntity.ok(repository.save(existing));
 })
 .orElse(ResponseEntity.notFound().build());
 }
 // DELETE -> 204 No Content (404 if id not found) (scope "write")
 @DeleteMapping("/{id}")
 @PreAuthorize("hasAuthority('SCOPE_write')")
 public ResponseEntity<Void> delete(@PathVariable Long id) {
 if (!repository.existsById(id)) {
 return ResponseEntity.notFound().build();
