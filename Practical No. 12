7. Controller — EmployeeRestController.java
Every GET converts Employee → EmployeeDTO with EmployeeMapper.toDto() before returning.
POST accepts an EmployeeDTO, maps it to a new entity, and saves. PUT fetches the existing entity,
overwrites only empName/department from the incoming DTO, and leaves password (and salary)
completely untouched.
src/main/java/com/example/employeeapi/controller/EmployeeRestController.java
package com.example.employeeapi.controller;
import com.example.employeeapi.dto.EmployeeDTO;
import com.example.employeeapi.entity.Employee;
import com.example.employeeapi.mapper.EmployeeMapper;
import com.example.employeeapi.repository.EmployeeRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import java.util.List;
import java.util.NoSuchElementException;
import java.util.stream.Collectors;
@RestController
@RequestMapping("/api/employees")
public class EmployeeRestController {
 private final EmployeeRepository employeeRepository;
 @Autowired
 public EmployeeRestController(EmployeeRepository employeeRepository) {
 this.employeeRepository = employeeRepository;
 }
 // GET /api/employees -> list of EmployeeDTO (no password, no salary)
 @GetMapping
 public ResponseEntity<List<EmployeeDTO>> getAll() {
 List<EmployeeDTO> dtos = employeeRepository.findAll().stream()
 .map(EmployeeMapper::toDto)
 .collect(Collectors.toList());
 return ResponseEntity.ok(dtos);
 }
 // GET /api/employees/{id} -> single EmployeeDTO
 @GetMapping("/{id}")
 public ResponseEntity<EmployeeDTO> getById(@PathVariable int id) {
 Employee employee = employeeRepository.findById(id)
 .orElseThrow(() -> new NoSuchElementException(
 "Employee not found with id: " + id));
 return ResponseEntity.ok(EmployeeMapper.toDto(employee));
 }
 // POST /api/employees -> accepts EmployeeDTO, saves as Employee, returns EmployeeDTO
 @PostMapping
 public ResponseEntity<EmployeeDTO> create(@RequestBody EmployeeDTO dto) {
 Employee employee = EmployeeMapper.toEntity(dto);
 // password/salary are not part of the DTO, so they remain null until
 // set through an internal/admin process - never through this endpoint.
 Employee saved = employeeRepository.save(employee);
 return new ResponseEntity<>(EmployeeMapper.toDto(saved), HttpStatus.CREATED);
 }
 // PUT /api/employees/{id} -> maps DTO fields onto the existing entity,
 // preserving password (and salary) untouched
 @PutMapping("/{id}")
 public ResponseEntity<EmployeeDTO> update(@PathVariable int id,
 @RequestBody EmployeeDTO dto) {
 Employee existing = employeeRepository.findById(id)
 .orElseThrow(() -> new NoSuchElementException(
 "Employee not found with id: " + id));
 // Only the DTO-visible fields are updated.
 // existing.password and existing.salary are never reassigned here.
 if (dto.getEmpName() != null) {
 existing.setEmpName(dto.getEmpName());
 }
 if (dto.getDepartment() != null) {
 existing.setDepartment(dto.getDepartment());
 }
 Employee updated = employeeRepository.save(existing);
 return ResponseEntity.ok(EmployeeMapper.toDto(updated));
 }
 // DELETE /api/employees/{id}
 @DeleteMapping("/{id}")
 public ResponseEntity<Void> delete(@PathVariable int id) {
 if (!employeeRepository.existsById(id)) {
 throw new NoSuchElementException("Employee not found with id: " + id);
 }
 employeeRepository.deleteById(id);
 return ResponseEntity.noContent().build(); // 204
 }
}
