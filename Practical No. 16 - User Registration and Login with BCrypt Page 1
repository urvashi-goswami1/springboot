package com.example.userauth.controller;
import com.example.userauth.model.AppUser;
import com.example.userauth.repository.AppUserRepository;
import java.util.Map;
import java.util.Optional;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.core.Authentication;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.web.bind.annotation.*;
Practical No. 16 - User Registration and Login with BCrypt Page 5
@RestController
@RequestMapping("/api/auth")
public class AuthController {
 private final AppUserRepository appUserRepository;
 private final PasswordEncoder passwordEncoder;
 public AuthController(AppUserRepository appUserRepository,
 PasswordEncoder passwordEncoder) {
 this.appUserRepository = appUserRepository;
 this.passwordEncoder = passwordEncoder;
 }
 // POST /api/auth/register (public) -> 201 Created
 @PostMapping("/register")
 public ResponseEntity<?> register(@RequestBody AppUser user) {
 if (isBlank(user.getUsername()) || isBlank(user.getPassword())) {
 return ResponseEntity.badRequest()
 .body(Map.of("error", "username and password are required"));
 }
 if (appUserRepository.findByUsername(user.getUsername()).isPresent()) {
 return ResponseEntity.status(HttpStatus.CONFLICT)
 .body(Map.of("error", "Username already exists"));
 }
 user.setUserId(0); // force INSERT
 user.setPassword(passwordEncoder.encode(user.getPassword())); // BCrypt hash
 if (isBlank(user.getRole())) {
 user.setRole("USER");
 }
 AppUser saved = appUserRepository.save(user);
 return ResponseEntity.status(HttpStatus.CREATED).body(saved);
 }
 // PUT /api/auth/profile (secured) -> 200 OK
 // Updates the username and/or role of the currently authenticated user only.
 @PutMapping("/profile")
 public ResponseEntity<?> updateProfile(Authentication authentication,
 @RequestBody AppUser updated) {
 Optional<AppUser> found = appUserRepository.findByUsername(authentication.getName());
 if (found.isEmpty()) {
 return ResponseEntity.notFound().build();
 }
 AppUser current = found.get();
 String newName = updated.getUsername();
 if (!isBlank(newName) && !newName.equals(current.getUsername())) {
 if (appUserRepository.findByUsername(newName).isPresent()) {
 return ResponseEntity.status(HttpStatus.CONFLICT)
 .body(Map.of("error", "Username already exists"));
 }
 current.setUsername(newName);
 }
 if (!isBlank(updated.getRole())) {
 current.setRole(updated.getRole());
 }
 return ResponseEntity.ok(appUserRepository.save(current));
 }
 // DELETE /api/auth/deregister (secured) -> 204 No Content
 // Removes the account of the currently authenticated user only.
 @DeleteMapping("/deregister")
 public ResponseEntity<Void> deregister(Authentication authentication) {
 appUserRepository.findByUsername(authentication.getName())
 .ifPresent(appUserRepository::delete);
 return ResponseEntity.noContent().build();
 }
 private boolean isBlank(String s) {
 return s == null || s.isBlank();
 }
}
